{
  "schema_name": "normalized_event",
  "schema_version": "v1",
  "layer": "normalized",
  "description": "Canonical Stage Two normalized event schema for DNS, host, network, and hybrid events.",
  "null_policy": {
    "missing_values": "Use JSON null / SQL NULL / Parquet null when a source field is absent or not applicable.",
    "labels": "Do not treat missing labels as benign. Use label_binary=null, label_source=none, label_status=unlabeled.",
    "timestamps": "Use timestamp=null and timestamp_type=missing when no timestamp exists; ordered streams must provide event_index.",
    "test_split": "Do not fit imputers, encoders, scalers, thresholds, feature selectors, or models on TEST statistics."
  },
  "fields": [
    {"name": "event_uid", "type": "string", "nullable": false},
    {"name": "dataset_id", "type": "int64", "nullable": true},
    {"name": "file_id", "type": "int64", "nullable": true},
    {"name": "dataset_name", "type": "string", "nullable": false},
    {"name": "dataset_role", "type": "string", "nullable": false, "allowed_values": ["TRAIN", "VALIDATION", "TEST", "EXPERIMENTS"]},
    {"name": "branch", "type": "string", "nullable": false, "allowed_values": ["dns", "host", "network", "hybrid"]},
    {"name": "source_format", "type": "string", "nullable": false},
    {"name": "source_file_path", "type": "string", "nullable": false},
    {"name": "source_file_hash", "type": "string", "nullable": true},
    {"name": "parser_name", "type": "string", "nullable": false},
    {"name": "parser_version", "type": "string", "nullable": false},
    {"name": "parser_run_id", "type": "int64", "nullable": true},
    {"name": "schema_name", "type": "string", "nullable": false},
    {"name": "schema_version", "type": "string", "nullable": false},
    {"name": "timestamp", "type": "timestamp[us, tz=UTC]", "nullable": true},
    {"name": "timestamp_source", "type": "string", "nullable": true},
    {"name": "timestamp_type", "type": "string", "nullable": false, "allowed_values": ["absolute", "relative", "event_order", "missing"]},
    {"name": "event_index", "type": "int64", "nullable": true},
    {"name": "entity_type", "type": "string", "nullable": false},
    {"name": "entity_id", "type": "string", "nullable": true},
    {"name": "event_type", "type": "string", "nullable": false},
    {"name": "raw_event_name", "type": "string", "nullable": true},
    {"name": "modality", "type": "string", "nullable": false},
    {"name": "host_name", "type": "string", "nullable": true},
    {"name": "user_name", "type": "string", "nullable": true},
    {"name": "process_id", "type": "string", "nullable": true},
    {"name": "process_name", "type": "string", "nullable": true},
    {"name": "parent_process_id", "type": "string", "nullable": true},
    {"name": "parent_process_name", "type": "string", "nullable": true},
    {"name": "src_ip", "type": "string", "nullable": true},
    {"name": "dst_ip", "type": "string", "nullable": true},
    {"name": "src_port", "type": "int64", "nullable": true},
    {"name": "dst_port", "type": "int64", "nullable": true},
    {"name": "protocol", "type": "string", "nullable": true},
    {"name": "domain", "type": "string", "nullable": true},
    {"name": "query_domain", "type": "string", "nullable": true},
    {"name": "qtype", "type": "string", "nullable": true},
    {"name": "qclass", "type": "string", "nullable": true},
    {"name": "ttl", "type": "int64", "nullable": true},
    {"name": "rcode", "type": "string", "nullable": true},
    {"name": "syscall_name", "type": "string", "nullable": true},
    {"name": "event_id", "type": "string", "nullable": true},
    {"name": "command_line", "type": "string", "nullable": true},
    {"name": "file_path", "type": "string", "nullable": true},
    {"name": "metric_name", "type": "string", "nullable": true},
    {"name": "metric_value", "type": "float64", "nullable": true},
    {"name": "label_binary", "type": "int8", "nullable": true, "allowed_values": [0, 1, null]},
    {"name": "label_family", "type": "string", "nullable": true},
    {"name": "label_subtype", "type": "string", "nullable": true},
    {"name": "label_source", "type": "string", "nullable": false, "allowed_values": ["embedded_column", "filename", "scenario_metadata", "external_label_file", "ids_alert", "ground_truth_csv", "none"]},
    {"name": "label_status", "type": "string", "nullable": false, "allowed_values": ["explicit_label", "inferred_label", "weak_label", "partial_label", "unlabeled", "conflicting_label"]},
    {"name": "label_confidence", "type": "float64", "nullable": true},
    {"name": "label_mapping_rule_id", "type": "string", "nullable": true},
    {"name": "features_json", "type": "json", "nullable": true},
    {"name": "raw_fields_json", "type": "json", "nullable": true},
    {"name": "metadata_json", "type": "json", "nullable": true},
    {"name": "created_at", "type": "timestamp[us, tz=UTC]", "nullable": false}
  ]
}
