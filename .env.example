# Stage Two example configuration.
# Copy this file to .env for local development and keep .env out of Git.
# Do not commit production credentials, private hosts, tokens, or real passwords.

# ---------------------- PATHS FOLDERS ---------------------- #

PATH_DATA_STORAGE=C:\Users\Public\PythonProjects\storage
PATH_FOLDER_DATASETS=C:\Users\Public\PythonProjects\storages\datasets
PATH_FOLDER_DATASETS_FILTER=C:\Users\Public\PythonProjects\storages\datasets-filter

PATH_REPORT=${PATH_DATA_STORAGE}/reports
PATH_TEMP_DATA=${PATH_DATA_STORAGE}/temp_data

# -------------------------- DATABASE SETTINGS --------------------- #

POSTGRES_DB=proposal_catalog
POSTGRES_USER=proposal_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_local_only

# ------------------------------ DB Connection --------------------- #

DATABASE_URL=postgresql+psycopg://proposal_user:change_me_local_only@localhost:5432/proposal_catalog

# -------------------------- STAGE THREE SETTINGS -------------------- #

STAGE_THREE_DEFAULT_PROFILE=balanced
STAGE_THREE_ACCELERATION_BACKEND=auto
STAGE_THREE_RESERVED_RAM_GB=8
STAGE_THREE_SOFT_RAM_LIMIT_GB=48
STAGE_THREE_HARD_RAM_LIMIT_GB=56
STAGE_THREE_DEFAULT_WORKERS=8
STAGE_THREE_MAX_WORKERS=12
STAGE_THREE_DB_WORKERS=4
STAGE_THREE_BATCH_ROWS=250000
STAGE_THREE_PARQUET_ROW_GROUP_SIZE=250000
STAGE_THREE_GPU_MEMORY_SOFT_LIMIT_GB=12
STAGE_THREE_GPU_MEMORY_HARD_LIMIT_GB=14
